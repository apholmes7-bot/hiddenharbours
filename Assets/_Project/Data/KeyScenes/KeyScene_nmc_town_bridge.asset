    - Key: nmc.scene.sound
      Value: '[{"id":"sound.nmc_town_river_bridge","kind":"river","at":[-186,205],"z":1,"radiusM":16,"gain":"the
        flood and the ebb run under the bridge: louder with the tide\u2019s rate","lane":"audio"},{"id":"sound.nmc_river_deck","kind":"patio","at":[-204,222],"z":6.5,"radiusM":12,"gain":"voices
        and glasses while the restaurant is open (the game\u2019s hours)","lane":"audio"}]'
    - Key: nmc.scene.game
      Value: '["the bridge as a road span (NineMileCreekRoads: Route 91 flies over
        the river; no road cell on the water)","the wall and its fill in the height
        bake (ground.laid)","the boardwalks, the deck and the stairs as walkable decks
        on their own heights","the lamps on the lamp rule (dusk to dawn)","the names
        on the bridge\u2019s plates and the chandlery\u2019s boards are the owner\u2019s
        (words.*), blank in pictures"]'
    - Key: nmc.scene.budgets
      Value: '{"masters":[{"board":"bridge_golden","sprites":301,"byFamily":{"piece":37,"building":1,"boat":1,"flower":18,"grass":244}},{"board":"bridge_night","sprites":296,"byFamily":{"piece":37,"building":1,"boat":1,"grass":230,"flower":27}},{"board":"deck_golden","sprites":130,"byFamily":{"piece":37,"building":1,"boat":1,"tree":2,"grass":42,"flower":47}},{"board":"deck_night","sprites":125,"byFamily":{"piece":37,"building":1,"boat":1,"tree":2,"grass":39,"flower":45}}],"frames":[{"frame":"wide_bridge","pieces":10,"lamps":3,"note":"plants
        and grass as the masters count them, by area"},{"frame":"of_boardwalk","pieces":13,"lamps":5,"note":"plants
        and grass as the masters count them, by area"},{"frame":"wide_deck","pieces":13,"lamps":5,"note":"plants
        and grass as the masters count them, by area"},{"frame":"of_deck","pieces":11,"lamps":3,"note":"plants
        and grass as the masters count them, by area"}],"note":"Every piece is one
        sprite; the bridge is the costliest (about 1,300 faces). The walls and boardwalks
        are one sprite per course or run."}'
    - Key: nmc.scene.ground
      Value: '{"source":"export/HH-nmc-ground-part-1-2026-09-30/ground/NineMileCreekSeabed_HeightTex_plan.png
        (16-bit, -6 to +6 m; file sha256 a998ce68ca3a8e05179b54d7f1b4d5d95ecdb804fca921b75c20df86ddd56c75,
        pixels sha256 edce029b38697ebfb3b15eb64f9286f08b697e93c699cd83556eb69236819564),
        with its still water, through NmcHeightTex","ruled":"09-30, the owner on part
        1: \u201cGo with leans\u201d (STATE.md s4)","laid":[],"inTexture":{"grading":"fill.nmc_river_wall","reissue":"HH-nmc-ground-part-1-reissue-2026-10-01
        (pixels 00cf42cf\u2026), kept in HH-nmc-ground-part-1-reissue-2-2026-10-02","laid":[{"id":"wall.nmc_river_wall","what":"the
        river wall under Water Street, and the fill behind it","kind":"retaining wall
        + fill","lane":"terrain (the height bake) and building (the wall as a set
        piece)","line":[[-262,215.74],[-258,216.54],[-254,217.42],[-250,218.26],[-246,219.13],[-242,220.04],[-238,220.93],[-234,221.71],[-230,222.36],[-226,222.86],[-222,223.28],[-218,223.66],[-214,223.99],[-210,224.25],[-206,224.42],[-202,224.5],[-198,224.41],[-194,224.24],[-190,223.78],[-186,222.93],[-182,222.33],[-178,222.53],[-174,222.49],[-170,222.08],[-166,221.63],[-162,221.16],[-158,220.62],[-154,219.96],[-150,219],[-146,217.51]],"top":6,"cap":6.2,"foot":[2.7,2.99],"thickM":0.9,"fillBandM":16,"taperM":4,"maxFillM":3.3,"maxFillAt":[-179,222.5],"fillAreaM2":1457,"rule":"the
        wall stands on the north bench\u2019s back edge (where the texture\u2019s
        bank starts to climb north of the boardwalk, as a 9 m running mean); behind
        it, within 16 m, the ground is raised to +6.0 wherever it lies between +2.5
        and +6.0; the last 4 m at each end ease back to the texture","why":"plan.json
        draws the north bank as a stone wall up to Water Street at +6.0 (water.streams[town_river].banks.town.north.wall);
        the texture carries a grass bank at 1:3 to 1:4 there, with Water Street on
        it at +4.4 to +6.0. The scene lays the wall so the street, the deck and the
        lots stand level. The owner\u2019s call 15 (NOTES-part2 s6)."}]},"standsOn":"export/HH-nmc-ground-part-1-reissue-2-2026-10-02/
        (pixels b997bdce\u2026)","laidNote":"No scene lays ground of its own: the
        river wall\u2019s fill this scene laid on part 1\u2019s first texture is in
        the texture since the 10-01 re-issue (call 15), by the same rule. The boards
        stand as baked."}'
    - Key: nmc.scene.context
      Value: '{"river":"stream.nmc_town_river (Nine Mile Creek): bed about -0.4 at
        the bridge, 10 m wide; the still ribbon at bed + 0.35 on the ebb","roads":["road.nmc_route_91
