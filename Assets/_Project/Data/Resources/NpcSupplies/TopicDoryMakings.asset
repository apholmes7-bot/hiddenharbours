  Fallbacks:
  - NpcId: npc.marguerite_leblanc
    Line: 'That''s all I know of it. Ask round.'
  - NpcId: npc.junior_poirier
    Line: 'Ask somebody who stays put. I''m on the flats.'
  - NpcId: npc.eileen_doiron
    Line: 'I''ve told you what I know. The children may know more.'
  - NpcId: npc.aunt_ginny
    Line: 'That''s my lot, child. Ask about.'
  - NpcId: npc.rose_macisaac
    Line: 'I''ve nothing more for you, dear. Knock again if you''re short.'
