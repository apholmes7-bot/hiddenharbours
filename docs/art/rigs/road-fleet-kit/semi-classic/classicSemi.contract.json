    "visor": {
      "part": "visor:true|false",
      "default": true,
      "what": "the drop visor over the two-piece windshield",
      "rule": "no z changes and an IDENTICAL painted bbox either way (asserted) — pack once, toggle freely"
    },
    "roll": {
      "param": "roll",
      "units": "revolutions",
      "per_wheel": [
        "wFL",
        "wFR",
        "wRL",
        "wRR"
      ],
      "distance_per_rev_m": 3.142,
      "cyclic": "Exact integer-revolution wrap; 28 tread periods per circumference. Verified for all eight facings in validation.json."
    },
    "suspension": {
      "params": [
        "susF",
        "susR"
      ],
      "range": [
        -1,
        1
      ],
      "travel_m": {
        "front": 0.09,
        "rear": 0.11
      },
      "formula": "dz(y) = -(susF*0.09)*t - (susR*0.11)*(1-t),  t = (y - (-2.20)) / 5.65",
      "note": "the BODY moves — including the stacks and the coupling point; the wheels stay on the ground"
    },
    "steer": {
      "param": "steer",
      "range": [
        -1,
        1
      ],
      "sense": "+1 is full LEFT lock (the nose swings toward -x)",
      "deg": {
        "inner": 30,
        "outer": 26.24
      },
      "geometry": "Ackermann: outer = atan(1/(1/tan(inner) + track/wheelbase)), front track 1.68, wheelbase 5.65 (to the tandem centre).",
      "axis": "vertical, through each front wheel centre. No kingpin offset, no caster, no scrub radius.",
      "swept_extreme_x_m": 1.22,
      "note": "the widest circle in the pack — the long hood pays for its presence in lock. Bobtail geometry; a coupled trailer’s off-tracking is the game’s arithmetic."
    },
    "yaw": {
      "param": "yaw",
      "units": "degrees",
