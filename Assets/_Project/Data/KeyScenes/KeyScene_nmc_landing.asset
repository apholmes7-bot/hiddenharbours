    - Key: nmc.ownerScene
      Value: keyscene.nmc_landing
    - Key: nmc.type
      Value: SetPieceDef
    - Key: nmc.scene.sound
      Value: '[{"id":"sound.nmc_landing_surf","kind":"surf","at":[72,-164],"z":0,"radiusM":22,"gain":"the
        swash on the corner beach; quiet at the spring low, when the bar holds the
        sea off","lane":"audio"}]'
    - Key: nmc.scene.game
      Value: '["the crossing open or closed by the tide: the board\u2019s tide table
        (words.nmc_crossing_tides) bound to the game\u2019s tide; the notice words.nmc_crossing_notice","the
        stakes as solid markers along the bar walk","the bell on the board rung in
        fog","the life ring takeable"]'
    - Key: nmc.scene.budgets
      Value: '{"masters":[{"board":"landing_low","sprites":92,"byFamily":{"piece":9,"rock":14,"boat":1,"flower":21,"grass":43,"shrub":4}},{"board":"landing_flood","sprites":84,"byFamily":{"piece":9,"rock":17,"boat":1,"grass":45,"flower":12}}],"frames":[{"frame":"wide_landing","pieces":9,"lights":0,"note":"plants
        and grass as the masters count them, by area"},{"frame":"of_head","pieces":10,"lights":0,"note":"plants
        and grass as the masters count them, by area"}],"note":"Every piece is one
        sprite (the Falls: its rock and its painted water, two); the campers are the
        costliest."}'
    - Key: nmc.scene.ground
      Value: '{"source":"export/HH-nmc-ground-part-1-2026-09-30/ground/NineMileCreekSeabed_HeightTex_plan.png
        (16-bit, -6 to +6 m; file sha256 a998ce68ca3a8e05179b54d7f1b4d5d95ecdb804fca921b75c20df86ddd56c75,
        pixels sha256 edce029b38697ebfb3b15eb64f9286f08b697e93c699cd83556eb69236819564),
        with its still water, through NmcHeightTex","ruled":"09-30, the owner on part
        1: \u201cGo with leans\u201d (STATE.md s4)","laid":[],"note":"The landing
        lays nothing: the wrack line, the wet films on the flats and the cobbles on
        the strand are the picture\u2019s (the game\u2019s shore shading), not ground."}'
    - Key: nmc.scene.context
      Value: '{"crossing":"path.nmc_bar_walk (tidal crossing, 3 m, on the bar\u2019s
        crest to the seam)","road":"road.nmc_bar_road (its end at (58, -146))","path":"path.nmc_shore_path
        (its head at (60, -150))","beach":"path.nmc_south_strand (the south shore\u2019s
        beach, running west)","changedFromPlan":[{"what":"the crossing\u2019s stakes","plan":"none","scene":"a
        stake every 8 m on the bar walk\u2019s line, from where the beach falls below
        +3.0","why":"the crossing is walked at low water; the stakes mark it in fog
        and on the flood"},{"what":"the crossing board","plan":"none","scene":"at
        (61.6, -149.6), facing the arrivals off the bar","why":"the crossing\u2019s
        notice and its tide table"}]}'
    - Key: nmc.scene.refs
      Value: '[]'
