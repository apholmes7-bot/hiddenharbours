    - Key: nmc.scene.sound
      Value: '[{"id":"sound.nmc_plaza","kind":"town","at":[-224,130],"z":6.5,"radiusM":30,"gain":"carts,
        car doors, the grocery\u2019s doors sliding; Route 91 beyond","lane":"audio"},{"id":"sound.nmc_water_street","kind":"town","at":[-162,228],"z":6.5,"radiusM":20,"gain":"the
        chandlery\u2019s bell, a radio on a porch, the river under the wall","lane":"audio"}]'
    - Key: nmc.scene.game
      Value: '["the storefronts as BuildingDefs facing south, their doors on the walk;
        the interiors are the plaza kit\u2019s own (plazaInteriorRig.js reads the
        same lease table)","the lot as a car park: its stalls, its cart corral, its
        poles lit on the lamp rule","the cars ambient and parked, the pickup on Water
        Street too","the bands and the pylon carry the trade words the kit draws (GROCERY,
        HARDWARE); the plaza\u2019s own name stays open","the three-decker\u2019s
        three flats, each a home"]'
    - Key: nmc.scene.budgets
      Value: '{"masters":[{"board":"plaza_morning","sprites":78,"byFamily":{"building":2,"piece":11,"vehicle":7,"flower":52,"grass":6}},{"board":"water_street_morning","sprites":177,"byFamily":{"piece":8,"building":1,"vehicle":1,"tree":3,"grass":54,"flower":108,"shrub":2}}],"frames":[{"frame":"wide_plaza","pieces":13,"lights":0,"note":"plants
        and grass as the masters count them, by area"},{"frame":"of_grocery","pieces":10,"lights":2,"note":"plants
        and grass as the masters count them, by area"},{"frame":"wide_water_street","pieces":7,"lights":2,"note":"plants
        and grass as the masters count them, by area"},{"frame":"of_chandlery","pieces":7,"lights":2,"note":"plants
        and grass as the masters count them, by area"}],"note":"Every piece is one
        sprite. The plaza\u2019s two bays are the costliest; its rows, island and
        corral lie flat under the cars. The bridge is the town bridge scene\u2019s,
        drawn at its numbers."}'
    - Key: nmc.scene.ground
      Value: '{"source":"export/HH-nmc-ground-part-1-reissue-2026-10-01/ground/NineMileCreekSeabed_HeightTex_plan.png
        (16-bit, -6 to +6 m; file sha256 e840457db37afd925afb585cab322e2908c9ec9643d758c58244a34ae32ad90f,
        pixels sha256 00cf42cf3ee43620f226bc916471f7d630bb3c9da58ec8324a840c8ca27b7848),
        with its still water, through NmcHeightTex","ruled":"10-01, the owner on part
        2 and part 1\u2019s record (\u201cI go with leans\u201d, STATE.md s4); the
        re-issue carries the groove\u2019s fill, lean A\u2019s ramp, the river wall\u2019s
        fill and the waterfront pads (STATE.md s6)","laid":[],"note":"Main street
        lays nothing. It stands on part 1\u2019s ground as re-issued on 10-01, where
        Water Street is level at +6.0 on the river wall\u2019s fill. The plaza\u2019s
        lot, its service yard and its entrance are road kit v4\u2019s town asphalt
        on the texture\u2019s +5.8 to +6.0."}'
    - Key: nmc.scene.context
      Value: '{"plaza":"lot.nmc_town_plaza: west of Route 91, south of Mill Road,
        across the road from the gas bar","roads":["road.nmc_route_91","road.nmc_mill_road
        (behind the plaza)","road.nmc_water_street (paved, on the wall\u2019s top)","road.nmc_north_creek_lane
        (behind the three-decker)"],"river":"stream.nmc_town_river, under the wall,
        below the frame","fromTownBridge":["structure.nmc_route91_bridge","structure.nmc_chandlery","structure.nmc_river_wall_09
        to .12","prop.nmc_street_lamp_w_04 and .w148: at the numbers in keyscene.nmc_town_bridge\u2019s
        scene.json"],"changedFromPlan":[{"what":"the plaza\u2019s facing (call 31)","plan":{"faces":"E","at":[-240.5,125],"size":[11,40.4],"parking":[-235,-205,104,146]},"scene":{"faces":"S","storefronts":"on
        y 138, x -242.4 to -205.6","walk":"y 135.65 to 138","lot":[-247,-201,117,135.65],"serviceYard":[-246,-202,148.5,155.5],"entrance":"from
        Route 91 along y 126.3"},"why":"in the game\u2019s camera a storefront that
        faces east is edge-on (PlazaIso dir 2), so the plaza would show only its roof
        and its south end wall. Faced south, both storefronts face the camera across
        their lot. The plaza keeps its site, its tenants and its neighbours: the gas
        bar across Route 91, Mill Road behind it, the lumber yard to the west."},{"what":"the
        hardware store","plan":"two doubles, 22 m of frontage","scene":"one anchor-size
        bay, 18.4 m: the plaza\u2019s older brick block, at its west end by the lumber
        yard","why":"the plaza kit draws a sign and a demising wall for each bay,
        so two doubles read as two hardware stores"},{"what":"the lot","plan":"40
        stalls in [-235, -205, 104, 146]","scene":"PlazaIso.plan\u2019s two rows of
        12 stalls (24), a planted island, a cart corral and four light poles, in front
        of the storefronts","why":"turned with the plaza; the kit lays its own lot"},{"what":"the
        three-decker by the bridge","plan":{"at":[-156,250],"size":[12.5,15.5]},"scene":{"centre":[-156,250],"bodyM":[11.4,12.2],"porchesM":2.1,"rearDeckM":1.85},"why":"StackFlatsIso
        decker3\u2019s own size: its porches reach 0.45 m past the lot\u2019s front
        line and its rear deck 0.2 m past the back"},{"what":"the second three-decker
        (lot.nmc_apartments_3, the optional third)","plan":{"at":[-136,244],"faces":"SW"},"scene":"not
        drawn (call 32)","why":"its lot runs down into the north creek\u2019s head:
        the ground falls from +6.0 along its south side to +3.2 at its north-east
        corner, where about 20 m\u00b2 of it lies under the creek\u2019s still water"}]}'
    - Key: nmc.scene.refs
      Value: '[{"id":"structure.nmc_route91_bridge","owner":"keyscene.nmc_town_bridge"},{"id":"structure.nmc_river_wall_09","owner":"keyscene.nmc_town_bridge"},{"id":"structure.nmc_river_wall_10","owner":"keyscene.nmc_town_bridge"},{"id":"structure.nmc_river_wall_11","owner":"keyscene.nmc_town_bridge"},{"id":"structure.nmc_river_wall_12","owner":"keyscene.nmc_town_bridge"},{"id":"prop.nmc_street_lamp_w_04","owner":"keyscene.nmc_town_bridge"},{"id":"prop.nmc_street_lamp_w_05","owner":"keyscene.nmc_town_bridge"},{"id":"structure.nmc_chandlery","owner":"keyscene.nmc_town_bridge"}]'
