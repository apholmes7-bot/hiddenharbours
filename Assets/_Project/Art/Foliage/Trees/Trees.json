        "name": "ADR-0006/0022",
        "view": "3/4 from S, orthographic",
        "elevDeg": 40.0,
        "heightScale": 0.7660444378852844,
        "depthScale": 0.6427876353263855
    },
    "light": {
        "key": [
            -0.5476772785186768,
            -0.6572127342224121,
            0.517803966999054
        ],
