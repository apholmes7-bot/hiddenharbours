  m_Script: {fileID: 11500000, guid: 88201f4f4f3247558c87e55aa4fb8ac4, type: 3}
  m_Name: DougieFirst
  m_EditorClassIdentifier: HiddenHarbours.World::HiddenHarbours.World.DialogueDef
  Id: dialogue.dougie_first
  FirstLines:
  - 'Dougie MacNeil. I''m on the cannery floor, me and Theresa and whoever else they can keep.'
  - 'Rene and I split the harbour gable. He''s out before light and I''m in after dark, so we get along fine.'
  - 'Fish comes in, somebody has to put it in a tin. That''s the whole job, and there''s less of it every year.'
  RepeatLines:
  - 'Back to the floor for me. Mind the tide.'
