  m_Script: {fileID: 11500000, guid: 88201f4f4f3247558c87e55aa4fb8ac4, type: 3}
  m_Name: RoseFirst
  m_EditorClassIdentifier: HiddenHarbours.World::HiddenHarbours.World.DialogueDef
  Id: dialogue.rose_first
  FirstLines:
  - 'Rose MacIsaac. The red house — so you know which door.'
  - 'The whole island knew you''d landed before you had your boots off. Don''t take that
    unkindly: a place this small has to know a thing before it can look after it.'
  - 'Anything you''re short of, you knock. That''s what a dooryard is for.'
  RepeatLines:
  - 'Door''s where it was. Knock if you''re short.'
