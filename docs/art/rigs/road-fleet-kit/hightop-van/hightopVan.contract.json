      "param": "hood",
      "range": [
        0,
        1
      ],
      "deg": [
        0,
        42
      ],
      "hinge": "cowl y=1.74 z=1.28, x-axis; stub clamshell over a real engine bay"
    },
    "roll": {
      "param": "roll",
      "units": "revolutions",
      "per_wheel": [
        "wFL",
        "wFR",
        "wRL",
        "wRR"
      ],
      "distance_per_rev_m": 2.262,
      "cyclic": "near — one revolution returns the hub lugs and index notch exactly; the tread advances 2.262 m over a 0.095 m stripe period (23.81 stripes), so roll:1 differs from roll:0 by 10 of 16827 painted px (0.06%). Seamless in motion, not bit-identical."
    },
    "suspension": {
      "params": [
        "susF",
        "susR"
      ],
      "range": [
        -1,
        1
      ],
      "travel_m": {
        "front": 0.08,
        "rear": 0.1
      },
      "formula": "dz(y) = -(susF*0.08)*t - (susR*0.10)*(1-t),  t = (y - (-1.76)) / 3.96",
      "note": "the BODY moves; the wheels stay on the ground"
    },
    "steer": {
      "param": "steer",
      "range": [
        -1,
        1
      ],
      "sense": "+1 is full LEFT lock (the nose swings toward -x)",
      "deg": {
        "inner": 24,
        "outer": 20.6
      },
      "geometry": "Ackermann: the inside wheel takes the larger angle. outer = atan(1/(1/tan(inner) + track/wheelbase)), track 1.64, wheelbase 3.96.",
      "axis": "vertical, through each front wheel centre. No kingpin offset, no caster, no scrub radius.",
      "swept_extreme_x_m": 1.076,
      "note": "the van has no flares to hide behind — the front ARCH BULGES (half-width 1.09 m) are the widest point, and at full lock a tire corner reaches |x| 1.076 m, just inside them. That is why the lock stops at 24 deg."
    },
    "yaw": {
      "param": "yaw",
      "units": "degrees",
      "range": [
        -45,
        45
      ],
      "what": "heading off the 45deg facing grid. Rotates the model about z before projection under the fixed key — the shading is REBAKED, not rotated.",
      "pivot": "unaffected — the origin still projects to the published pivot at any yaw",
      "painted_bbox_over_sweep": [
        90,
        86,
        293,
        271
      ],
      "cost": "the painted union grows to 204 x 186 px over a +/-22.5 sweep"
    },
