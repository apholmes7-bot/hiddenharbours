      "grip": "metres from the wrist to the object's own pivot; out is signed by the carrying hand",
      "pitch_yaw_bend": "degrees / unitless bend, the object's rest attitude in its own frame (rod convention: +y = character forward, pitch 0 = level, 90 = up)",
      "facing_deltas": "per-heading corrections added to grip and yaw; absent row = no correction",
      "turn": "heading for a turntable-baked prop, in 45deg steps RELATIVE to the body; pin() returns itemDir and the consumer renders the prop's own rig at itemDir instead of dir",
      "swap": "carry it in the other hand at this heading",
      "itemScale": "1 when the prop was baked for the hand; anything else is an art debt, not a setting"
    },
