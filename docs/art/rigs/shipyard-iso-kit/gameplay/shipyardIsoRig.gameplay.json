{
  "rig": "ShipyardIso",
  "version": "1.0",
  "generated": "2026-08-09",
  "contract": {
    "pipeline": "pre-rendered 3D -> pixel sprite. Flat-facet shading, one fixed upper-LEFT key in screen space, z-buffered, ordered (Bayer) dither, per-face uv texture, depth-edge darkening, 1 px keyline, no AA. Deterministic: same inputs -> identical pixels.",
    "camera": {
      "projection": "axonometric 3/4",
      "headings": [
        "N",
        "NE",
        "E",
        "SE",
        "S",
        "SW",
        "W",
        "NW"
      ],
      "dirs": 8,
      "step_deg": 45,
      "elev_deg_default": 40
    },
    "scale": {
      "native_px_per_m": 32,
      "note": "a whole SITE is a planning bake — fitScale() drops to 24/16/12/8 px per m so the sheet fits, and render() reports the scale it used in cell.pxPerM"
    },
    "lod": {
      "gte16": "full detail (lod 1)",
      "10to15": "lod 0.5 — weed fringe and sub-0.15 m trim dropped",
      "lt10": "lod 0 — massing only"
    },
    "axes": {
      "x": "along shore",
      "y": "+Y is water, -Y is the road / back fence",
      "z": "up, 0 = chart datum",
      "note": "same convention as wharfIsoRig, so a yard and a wharf module share a shoreline"
    },
    "origin": "model origin = footprint centre at chart datum. cell.px/cell.py is its projection — blit at screen(anchor) - (px,py).",
    "water": "ADR 0010/0012/0023 — ZERO water pixels are baked, even inside the wet basin. The rig publishes `wet` (per-pixel mask of its own submerged pixels); the shader owns the rest. opts.clipBelowWater drops those pixels outright.",
    "returns": {
      "data": "Uint8ClampedArray RGBA, row-major from top-left, straight alpha",
      "w": "px",
      "h": "px",
      "px": "origin x in cell",
      "py": "origin y in cell",
      "wet": "Uint8Array, 1 = below waterline",
      "dep": "Float32Array camera depth per px, Infinity where empty",
      "pxPerM": "scale this cell baked at",
      "mounts": "hull mounts in metres",
      "hulls": "how many hulls were composited"
    },
    "budget_ms": {
      "part": "15-60",
      "site": "250-2500 (largest yards at reduced px/m)",
      "note": "bake, atlas, blit — never call render per game frame"
    }
  },
  "hullMounts": {
    "schema": {
      "id": "mountN",
      "support": "blocks|cradle|davit|slings|afloat|ways",
      "cls": "SHIPS id",
      "label": "display name",
      "loa": "m",
      "beam": "m",
      "draft": "m",
      "depth": "m (keel to sheer)",
      "x": "m",
      "y": "m",
      "keelZ": "m — where the keel bottom sits",
      "heading": "deg, 0 = +X",
      "note": "plain-English support description"
    },
    "note": "Every cradle, davit, blocking stack, sling and basin berth publishes one. render(what,dir,{hulls:true}) composites the fleet bakes onto them; anchors() bakes the same points to CELL pixels for a compositor that wants to place its own sprites."
  },
