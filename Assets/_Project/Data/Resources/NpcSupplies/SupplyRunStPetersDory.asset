  m_Name: SupplyRunStPetersDory
  m_EditorClassIdentifier: HiddenHarbours.World::HiddenHarbours.World.SupplyRunDef
  Id: supplyrun.st_peters_dory
  BoatId: boat.dory
  TellerNpcId: npc.basil_samson
  NamedFlag: st_peters.dory_supplies.named
  NamingLines:
  - 'So you''ve bought her. Good. Now hear what she wants.'
  - 'A patch plank, and copper nails to hang it. A hank of oakum for the seam. A tin of linseed paint over the lot.'
  - 'I''ve none of it left. Ask about. This island keeps what it''s got.'
  MissingLines:
  - 'Plank and nails, oakum, paint. Somebody''s got it put by.'
  AllInHandLines:
  - 'That''s the lot. Get her up on the blocks and go at it.'
