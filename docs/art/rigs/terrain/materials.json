{
  "kit": "Hidden Harbours terrain materials",
  "version": 4,
  "pxPerMetre": 32,
  "colorSpace": "sRGB",
  "alpha": "always 255",
  "ladder": { "steps": ["_Lo", "", "_Hi"], "intensity": [0.0, 0.5, 1.0] },
  "baked": ["albedo", "grain", "non-directional cavity/crown"],
  "notBaked": ["key light", "cast shadow", "sun AO", "water", "pools", "wet/damp bands", "specular"],
  "materials": [
    { "key": "ripple",    "name": "Ripple",    "size": 512, "metres": 16, "projection": "plan", "chunkOffset": false, "pass": 2,
      "steps": ["relict, all but planed off", "working ripple field", "storm-built, gravel lag in the troughs"] },
    { "key": "shingle",   "name": "Shingle",   "size": 512, "metres": 16, "projection": "plan", "chunkOffset": true,  "pass": 2,
      "steps": ["pea gravel and coarse grit", "mixed shingle", "cobble lag, big stones proud"] },
    { "key": "grass",     "name": "Grass",     "size": 256, "metres": 8,  "projection": "plan", "chunkOffset": true,  "pass": 2,
      "steps": ["grazed, trodden thin turf", "sward", "rank meadow with seed heads"] },
    { "key": "marram",    "name": "Marram",    "size": 256, "metres": 8,  "projection": "plan", "chunkOffset": false, "pass": 2,
      "steps": ["pioneer sprigs on open sand", "stand", "closed hummock, heavy thatch"] },
    { "key": "sand",      "name": "Sand",      "size": 256, "metres": 8,  "projection": "plan", "chunkOffset": true,  "pass": 2,
      "steps": ["hardpack, quiet and fine", "dry sand with lineation", "coarse, shelly, wind-rippled"] },
    { "key": "shelf",     "name": "Shelf",     "size": 256, "metres": 8,  "projection": "plan", "chunkOffset": true,  "pass": 2,
      "steps": ["intact pavement", "slabs plucked out, second bed showing", "stripped to the third bed"] },

    { "key": "sandstone", "name": "Sandstone", "size": 512, "metres": 16, "projection": "face", "chunkOffset": false, "pass": 3,
      "steps": ["fresh face, recently collapsed", "weathered — joints open, blocks off", "badly eroded, deep alveolar hollows"] },
    { "key": "bank",      "name": "Bank",      "size": 512, "metres": 16, "projection": "face", "chunkOffset": false, "pass": 3,
      "steps": ["firm, faintly rilled", "well rilled, clods loose", "failing — deep gullies, hanging turf"] },
    { "key": "silt",      "name": "Silt",      "size": 512, "metres": 16, "projection": "plan", "chunkOffset": true,  "pass": 3,
      "steps": ["soft fresh sheet, barely drained", "drained, burrowed, patchy crust", "crusted, cracked into curled plates"] },
    { "key": "dirt",      "name": "Dirt",      "size": 256, "metres": 8,  "projection": "plan", "chunkOffset": true,  "pass": 3,
      "steps": ["a worn line, stubble and moss holding", "bare compacted earth, pebble lag", "churned — clods, loose tilth, grooves"] },
    { "key": "marsh",     "name": "Marsh",     "size": 256, "metres": 8,  "projection": "plan", "chunkOffset": true,  "pass": 3,
      "steps": ["pioneer sprigs on open creek mud", "closed cordgrass sward", "high marsh — thatch, wrack, salt pans"] },
    { "key": "sedge",     "name": "Sedge",     "size": 256, "metres": 8,  "projection": "plan", "chunkOffset": true,  "pass": 3,
      "steps": ["short sedge lawn, peat and moss showing", "tussocks", "rank tussocks, heavy thatch, rush over"] },

    { "key": "foreshore", "name": "Foreshore", "size": 512, "metres": 16, "projection": "plan", "chunkOffset": false, "pass": 4,
      "steps": ["planed — firm quiet sand, runnels only", "a working wave-ripple field", "megaripple, shell and gravel lag in the troughs"] },
    { "key": "talus",     "name": "Talus",     "size": 512, "metres": 16, "projection": "plan", "chunkOffset": true,  "pass": 4,
      "steps": ["a scatter of fallen slabs on a gravel floor", "a closed apron", "a deep chaotic blockfield, two-metre blocks"] },
    { "key": "ledge",     "name": "Ledge",     "size": 256, "metres": 8,  "projection": "plan", "chunkOffset": false, "pass": 4,
      "steps": ["intact bevelled pavement", "dissected — benches, scour pans, weed in the joints", "stripped to the third bed, cobble on the benches"] },
    { "key": "rockweed",  "name": "Rockweed",  "size": 256, "metres": 8,  "projection": "plan", "chunkOffset": false, "pass": 4,
      "steps": ["barnacled rock with scattered tufts", "a closed olive canopy", "deep drape, bladders showing, Ulva in the wet"] },

    { "key": "musselbed",  "name": "Musselbed",  "size": 512, "metres": 16, "projection": "plan", "chunkOffset": false, "pass": 5, "bed": true,
      "steps": ["spat and scattered clumps on a mud floor", "a closed bed", "thick and hummocked, mud mounded into it, dead shell in the troughs"] },
    { "key": "oysterreef", "name": "Oysterreef", "size": 512, "metres": 16, "projection": "plan", "chunkOffset": true,  "pass": 5, "bed": true,
      "steps": ["singles and cultch scattered on the mud", "a working reef, channels open", "a closed reef, channels choked with mud"] },
    { "key": "eelgrass",   "name": "Eelgrass",   "size": 256, "metres": 8,  "projection": "plan", "chunkOffset": false, "pass": 5, "bed": true,
      "steps": ["sparse shoots on open sand", "a closed meadow", "deep, epiphyte crusted, cut blades drifted in"] },
    { "key": "irishmoss",  "name": "Irishmoss",  "size": 256, "metres": 8,  "projection": "plan", "chunkOffset": true,  "pass": 5, "bed": true,
      "steps": ["scattered cushions on barnacled cobble", "a closed turf", "a deep drape, the cobble hidden"] },
    { "key": "lawn",      "name": "Lawn",      "size": 256, "metres": 8,  "projection": "plan", "chunkOffset": true,  "pass": 6,
      "steps": ["neglected — moss, bare scuffs, the first tussocks", "kept — clover and a little wear", "crisp — dense, fine, even, cut tips catching"] }
  ]
}
