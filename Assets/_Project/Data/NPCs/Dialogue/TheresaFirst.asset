  m_Script: {fileID: 11500000, guid: 88201f4f4f3247558c87e55aa4fb8ac4, type: 3}
  m_Name: TheresaFirst
  m_EditorClassIdentifier: HiddenHarbours.World::HiddenHarbours.World.DialogueDef
  Id: dialogue.theresa_first
  FirstLines:
  - 'Theresa Gillis. Cream house, second step. You''ll smell the cannery on me before you see me.'
  - 'Angus has the mussel beds and I have the packing table. Between us there''s supper and something to sell.'
  - 'Wipe your boots if you come in. That''s all I ask of anybody.'
  RepeatLines:
  - 'Still on your feet? Good. The island''s hard on new boots.'
