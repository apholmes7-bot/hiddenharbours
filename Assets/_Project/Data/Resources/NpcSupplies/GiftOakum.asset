  m_Name: GiftOakum
  m_EditorClassIdentifier: HiddenHarbours.World::HiddenHarbours.World.SupplyGiftDef
  Id: supplygift.st_peters_oakum
  GiverNpcId: npc.rose_macisaac
  OptionId: option.ask_for_oakum
  RowLabel: 'Would you have any oakum put by?'
  ReplyLines:
  - 'Oakum. Alec picked it every winter by that stove, and there''s a hank still in the press.'
  - 'Here. Better in a seam than in a drawer.'
  ItemIds:
  - supply.oakum
  ReceivedFlags:
  - st_peters.dory_mend.caulk_seam
  BagId: shoppingbag.paper
  HandsFullLines:
  - 'Your hands are full. Come back with one free and it''s yours.'
  BagFullLines:
  - 'That bag won''t take another thing. Empty it and come back.'
  BagElsewhereLines:
  - 'Where''s your bag got to? Fetch it and I''ll fill it.'
