    - Key: nmc.scene.sound
      Value: '[{"id":"sound.nmc_weather_face","kind":"surf","at":[48,-34],"z":-1.8,"radiusM":30,"gain":"the
        swell breaking on the ledges\u2019 edge; the squall\u2019s rain and gusts
        over it","lane":"audio"}]'
    - Key: nmc.scene.game
      Value: '["the steps as stairs; the ledges walkable when bared (below about -1.4)","the
        tide: the game warns on the flood; the steps are the way back up","the squall:
        rain, gusts, whitecaps; the sound of the swell on the ledges\u2019 lip","the
        sign\u2019s words (words.nmc_gully_sign), blank in pictures"]'
    - Key: nmc.scene.budgets
      Value: '{"masters":[{"board":"bluff_squall","sprites":342,"byFamily":{"piece":5,"rock":16,"tree":1,"grass":117,"flower":145,"shrub":6,"weed":52}}],"frames":[{"frame":"wide_face","pieces":11,"lights":0,"note":"plants
        and grass as the masters count them, by area"},{"frame":"of_ledges","pieces":9,"lights":0,"note":"plants
        and grass as the masters count them, by area"}],"note":"Every piece is one
        sprite (the Falls: its rock and its painted water, two); the campers are the
        costliest."}'
    - Key: nmc.scene.ground
      Value: '{"source":"export/HH-nmc-ground-part-1-2026-09-30/ground/NineMileCreekSeabed_HeightTex_plan.png
        (16-bit, -6 to +6 m; file sha256 a998ce68ca3a8e05179b54d7f1b4d5d95ecdb804fca921b75c20df86ddd56c75,
        pixels sha256 edce029b38697ebfb3b15eb64f9286f08b697e93c699cd83556eb69236819564),
        with its still water, through NmcHeightTex","ruled":"09-30, the owner on part
        1: \u201cGo with leans\u201d (STATE.md s4)","laid":[],"note":"The weather
        face lays nothing: the bluff, the cove and its ledges are part 1\u2019s texture.
        The red faces, the weed on the ledges\u2019 lip and the pools are the picture\u2019s
        paint; the rain is the squall\u2019s (WeatherSky rain 0.7) with streaks over
        the picture."}'
    - Key: nmc.scene.context
      Value: '{"bluff":"the ledge cliff north of the landing: +6 to the ledges at
        -1.4 to -1.7 in 3 to 4 m at the cove, a 1:1 face north of it","cove":"x 34..42,
        y -26..-44: the bluff broken back 4 m, its north wall facing the camera","path":"path.nmc_shore_path
        along the bluff\u2019s top","gully":"path.nmc_gully_path: it ends on the bluff
        at (32, -6), 17 m north of the cove","changedFromPlan":[{"what":"the gully
        steps","plan":"the gully path (a footpath) stops on the bluff\u2019s top at
        (32, -6)","scene":"timber steps from the bluff\u2019s top at (37.2, -23.2)
        down the cove\u2019s north wall to the ledges at (37.2, -30.4); a rail on
        the cove\u2019s west rim; a sign and a life ring at the head","why":"the cove
        is where the bluff is broken enough for steps (call 27)"}]}'
