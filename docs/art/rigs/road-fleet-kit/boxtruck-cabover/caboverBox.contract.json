  "articulation": {
    "doors": {
      "params": [
        "dL",
        "dR"
      ],
      "range": [
        0,
        1
      ],
      "deg": [
        0,
        65
      ],
      "hinge": "forward edge, vertical, at x +/-0.94 y 2.96"
