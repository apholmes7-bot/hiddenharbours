    - Key: nmc.scene.sound
      Value: '[{"id":"sound.nmc_south_shore","kind":"surf","at":[-264,-181],"z":2,"radiusM":25,"gain":"the
        swash on the berm at the flood; the fire; a screen door up on the bank","lane":"audio"}]'
    - Key: nmc.scene.game
      Value: '["the houses as homes, their doors to Route 91","the steps as stairs;
        the bank\u2019s red face not walkable","the beach walkable to the water; the
        flats below the frame dug for clams at low water","the fire ring lit in the
        evening on the lamp rule, a seat round it","the dory ambient"]'
    - Key: nmc.scene.budgets
      Value: '{"masters":[{"board":"strand_afternoon","sprites":212,"byFamily":{"building":2,"piece":5,"boat":1,"tree":2,"shrub":5,"grass":78,"flower":119}}],"frames":[{"frame":"wide_bank","pieces":5,"lights":0,"note":"plants
        and grass as the masters count them, by area"},{"frame":"of_beach","pieces":3,"lights":0,"note":"plants
        and grass as the masters count them, by area"}],"note":"Every piece is one
        sprite; the two houses are the costliest. The bank\u2019s red face, the wrack
        line and the lawns are the ground\u2019s paint, not sprites."}'
    - Key: nmc.scene.ground
      Value: '{"source":"export/HH-nmc-ground-part-1-reissue-2026-10-01/ground/NineMileCreekSeabed_HeightTex_plan.png
        (16-bit, -6 to +6 m; file sha256 e840457db37afd925afb585cab322e2908c9ec9643d758c58244a34ae32ad90f,
        pixels sha256 00cf42cf3ee43620f226bc916471f7d630bb3c9da58ec8324a840c8ca27b7848),
        with its still water, through NmcHeightTex","ruled":"10-01, the owner on part
        2 and part 1\u2019s record (\u201cI go with leans\u201d, STATE.md s4); the
        re-issue carries the groove\u2019s fill, lean A\u2019s ramp, the river wall\u2019s
        fill and the waterfront pads (STATE.md s6)","laid":[],"note":"The south shore
        lays nothing. The houses stand on part 1\u2019s bank top at +5.5 and the steps
        on its red bank, +5.2 down to +2.8. The red face, the wrack and the lawns
        are the picture\u2019s paint."}'
    - Key: nmc.scene.context
      Value: '{"beach":"coast.nmc_rice_point_strand: a red bank 2 m tall, a storm
        berm, then a sand beach whose flats run 42 m out at the spring low (below
        the frame)","lots":["lot.nmc_south_shore_4","lot.nmc_south_shore_5"],"road":"road.nmc_route_91,
        25 to 33 m north of the houses, above the frame; the houses\u2019 drives come
        off it","changedFromPlan":[{"what":"the houses","plan":"village houses, lots
        7 x 8.7 m, facing N, z 5.6","scene":"HouseIso dormerCape (lot 4) and gothicRevival
        (lot 5), at the kit\u2019s sizes, their doors north to Route 91, on the texture\u2019s
        ground (+5.49 and +5.51)","why":"the house kit\u2019s own sizes, as on the
        north creek; the texture\u2019s bank top stands 0.1 m under the plan\u2019s
        +5.6"},{"what":"the steps down the bank","plan":"none","scene":"timber steps
        (gullySteps) from each lawn\u2019s edge to the beach, 3 m east of each house\u2019s
        middle: 8.75 m long, 2.37 m down","why":"the bank is a 1:3 face, and the beach
        below is the shore\u2019s clam ground"},{"what":"a fire ring and a dory","plan":"none","scene":"a
        fire ring on the berm at (-263.5, -175.4); a dory hauled up at (-283, -175.4)","why":"the
        strand\u2019s evening fire, and a boat for the flats"}]}'
