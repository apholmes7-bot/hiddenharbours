  Id: cluetopic.st_peters_dory_makings
  OptionId: option.ask_about_dory_makings
  RowLabel: 'Who''d have the makings for a dory?'
  Ladders:
  - {fileID: 11400000, guid: 03a5006d65e247a3bd0e54ea215676bb, type: 2}
  - {fileID: 11400000, guid: bca81a7e06f14faf84f35ff001c20656, type: 2}
