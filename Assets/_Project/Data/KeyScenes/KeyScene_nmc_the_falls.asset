    - Key: nmc.scene.game
      Value: '["the steps\u2019 blocks and shelves as rock colliders, standable; the
        white water as the game\u2019s foam on the three lips (the painter is the
        look asked of it)","fishing: the pool below the third lip, from the Falls
        deck and the south shelves","the Falls deck (+3.4) and its landing (+3.2)
        as walkable decks","the Falls sound, loudest on the ebb","the sign\u2019s
        and the deck\u2019s notices are words (words.nmc_falls_sign, words.nmc_falls_notice),
        blank in pictures"]'
    - Key: nmc.scene.budgets
      Value: '{"masters":[{"board":"falls_morning","sprites":613,"byFamily":{"piece":17,"rock":5,"tree":6,"flower":268,"grass":295,"shrub":22}}],"frames":[{"frame":"wide_falls","pieces":9,"lights":0,"note":"plants
