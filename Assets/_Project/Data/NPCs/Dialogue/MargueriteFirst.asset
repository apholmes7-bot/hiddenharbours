  m_Script: {fileID: 11500000, guid: 88201f4f4f3247558c87e55aa4fb8ac4, type: 3}
  m_Name: MargueriteFirst
  m_EditorClassIdentifier: HiddenHarbours.World::HiddenHarbours.World.DialogueDef
  Id: dialogue.marguerite_first
  FirstLines:
  - 'You''ll be the one stopping up at Ginny''s. Word gets round this island faster
    than the tide does.'
  - 'LeBlanc''s, such as it is. Shovel, line, bait, and whatever the boat brings me.
    If I haven''t got it, you don''t need it yet.'
  - 'And I''ll not price my neighbours the way they do over at Nine Mile Creek. A store
    that squeezes a small place kills it — and then where''s the store?'
  RepeatLines:
  - 'Back again. If you''re for the flats, go on the falling tide — I''ll still be here
    after.'
