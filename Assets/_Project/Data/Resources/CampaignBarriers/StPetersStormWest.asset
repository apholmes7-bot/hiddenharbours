  m_Name: StPetersStormWest
  m_EditorClassIdentifier: HiddenHarbours.World::HiddenHarbours.World.CampaignBarrierDef
  Id: campaign_barrier.st_peters_storm_west
  Description: "The weather that stands off St Peters' west edge, toward the West Water and Nine Mile Creek by sea, until the island's first week is done. It finds only a boat at the helm; it never pushes a walker on the bar."
  RegionId: region.st_peters
  EdgePoint: {x: -380, y: 0}
  InwardNormal: {x: 1, y: 0}
  HalfLengthMetres: 0
  LiftedByFlag: st_peters.weather_turned
  StandsWhileFlag: st_peters.first_week
  StartDistanceMetres: 130
  FullDistanceMetres: 85
  LimitDistanceMetres: 55
  PushAcceleration: 2
  LimitStiffness: 2
  LimitDamping: 2
  MaxPushAcceleration: 8
  StormWindSpeed: 22
  StormVisibility01: 0.12
  StormSeaState01: 1
  LookFullDistanceMetres: 105
  StormRain01: 1
  StormRainStreakScale: {x: 8, y: 2}
  SightDistanceMetres: 230
  SquallDarkness01: 0.6
  SquallFeather01: 0.5
  SquallTint: {r: 0.05, g: 0.07, b: 0.1, a: 1}
  Line: "Black weather out west, and the sea's getting up. Not that way. Not yet."
  LineAtStorm01: 0.35
  LineCooldownSeconds: 600
