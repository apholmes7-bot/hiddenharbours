        "dR"
      ],
      "range": [
        0,
        1
      ],
      "deg": [
        0,
        65
      ],
      "hinge": "forward edge, vertical, at x +/-0.98 y 2.38",
      "note": "cab doors — they do NOT ride the hood"
    },
    "rollup": {
      "param": "rollup",
      "range": [
        0,
        1
      ],
      "opening": {
        "x": [
          -1.1,
          1.1
        ],
        "sill_z": 1.1,
        "head_z": 3.4
      },
      "slats": 15,
      "slat_m": 0.16,
      "travel_m": 2.4,
      "track": "vertical 2.30 m up the rear plane (y -5.03), then forward under the roof — the stack lies flat at z 3.52, above the door head and below the ceiling",
      "rule": "the door NEVER leaves the body: the painted bbox at N is identical closed and open, and the harness asserts it. Zero keep-clear behind the truck.",
      "stack_over": {
        "y": [
          -4.87,
          -2.47
        ],
        "z": [
          3.52,
          3.55
        ]
      }
    },
    "gate": {
      "param": "gate",
      "range": [
        0,
        1
      ],
      "phases": {
        "swing": [
          0,
          0.45,
          "the folded platform swings from the stow under the tail to dock height, level with the floor"
        ],
        "unfold": [
          0.45,
          0.7,
          "the flip half rotates 180deg aft — full 1.26 m platform at dock height"
        ],
        "lower": [
          0.7,
          1,
          "the arms lower the level platform to the ground"
        ]
      },
      "platform_m": {
        "width": 2.2,
        "main": 0.66,
        "flip": 0.6,
        "total_depth": 1.26,
        "thickness": 0.055
      },
      "dock_z": 1.1,
      "ground_z": 0.03,
      "arm_pivot": [
        0.8,
        -4.6,
        0.64
      ],
      "stowed": "folded double under the tail, forward edge y -4.54 z 0.76, tilted 24deg — inside the LOA, steel bottom at 0.44 m",
      "deployed_over": {
        "y": [
          -6.52,
          -5.26
        ],
        "x": [
          -1.1,
          1.1
        ]
      },
      "part": "liftgate:true|false — false removes the mechanism entirely (plain-tail build with the same bumperettes and ICC bar)"
    },
    "hood": {
      "param": "hood",
      "range": [
        0,
        1
      ],
      "deg": [
        0,
        70
      ],
      "hinge": "x-axis at y 4.08 z 0.60 — the front bumper stays; hood, cheeks, fenders, arches, grille and headlamps all ride it. The CAB does not move.",
      "bares": "engine block, valve cover, radiator wall and air cleaner on the chassis; twin latches at the cowl corners",
      "extreme": "at full tilt the hood nose reaches y 4.87 at z 0.81 — 0.57 m past the bumper. Still inside the cell in all 8 facings."
    },
    "fairing": {
      "part": "fairing:true|false",
      "default": true,
      "what": "the cab roof fairing (z 2.86 -> 3.38) carrying the five amber ID lamps; false moves the lamps to the bare roof",
      "rule": "no published z changes either way — the box (3.68) owns the skyline, and the painted top row is identical (asserted)"
    },
    "roll": {
      "param": "roll",
      "units": "revolutions",
      "per_wheel": [
        "wFL",
        "wFR",
        "wRL",
        "wRR"
      ],
      "distance_per_rev_m": 2.827,
      "cyclic": "one revolution returns hub lugs and hand-holes exactly and the tread to a sub-pixel phase (27.001 stripes of 0.1047 m): the seam is 1 px of 32093 painted (0%). A half revolution lands mid-stripe, so the cue visibly moves."
    },
    "suspension": {
      "params": [
        "susF",
        "susR"
      ],
      "range": [
        -1,
        1
      ],
      "travel_m": {
        "front": 0.1,
        "rear": 0.14
      },
      "formula": "dz(y) = -(susF*0.10)*t - (susR*0.14)*(1-t),  t = (y - (-2.90)) / 6.10",
      "note": "the BODY moves (frame, hood clip, cab, box, roll-up, liftgate); the wheels stay on the ground"
    },
    "steer": {
      "param": "steer",
      "range": [
        -1,
        1
      ],
      "sense": "+1 is full LEFT lock (the nose swings toward -x)",
      "deg": {
        "inner": 35,
        "outer": 30.32
      },
      "geometry": "Ackermann: the inside wheel takes the larger angle. outer = atan(1/(1/tan(inner) + track/wheelbase)), front track 1.72, wheelbase 6.10.",
      "axis": "vertical, through each front wheel centre. No kingpin offset, no caster, no scrub radius.",
      "swept_extreme_x_m": 1.233,
      "note": "the biggest lock in the pack (35deg to the cabover 33) yet a WIDER circle — 6.10 m of wheelbase taxes every degree. The painted fenders (half-width 1.25 m) are the envelope; the tire corner keeps 17 mm inside them."
    },
    "yaw": {
      "param": "yaw",
      "units": "degrees",
      "range": [
        -45,
        45
      ],
      "what": "heading off the 45deg facing grid. Rotates the model about z before projection under the fixed key — the shading is REBAKED, not rotated.",
      "pivot": "unaffected — the origin still projects to the published pivot at any yaw",
      "painted_bbox_over_sweep": [
        53,
        18,
        394,
        312
      ]
    },
    "parts": {
      "mirrors": true,
      "mudflaps": true,
      "liftgate": true,
      "fairing": true
    },
    "night": {
      "param": "night",
      "effect": "glass ramp swaps, headlamps become glow, lit spill on neighbouring pixels"
    },
    "weather": {
      "param": "weather",
      "range": [
        0,
        1
      ],
      "default": 0.32,
      "effect": "greys and grimes the paint, rusts iron/galv/rubber, speckles at 5% x weather"
    }
