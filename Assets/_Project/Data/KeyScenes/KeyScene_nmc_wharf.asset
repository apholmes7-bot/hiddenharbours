        adds the river\u2019s low-water ribbon to the still map and changes no ground","mouth":{"at":[222,156],"into":"the
        bay, past the yard\u2019s east end"}},{"id":"stream.nmc_north_creek","name":"the
        north creek","ruled":"09-26: a small creek running west inland from the water
        north of the wharf, with waterfront properties","pts":[[68,226],[54,230.5],[40,234],[26,232],[12,236.5],[-4,240.5],[-20,236.5],[-36,238],[-50,244.5],[-64,243],[-78,246.5],[-92,249.5],[-104,248.5],[-115,252.5]],"z":[-1.8,-1.35,-1.05,-0.85,-0.65,-0.45,-0.25,-0.05,0.2,0.55,1.2,2.1,2.85,3.45],"w":[12,10.5,9.5,9,8.5,8,7.5,7,6.5,6,5,4,3.2,2.6],"depth":[0.3,0.3,0.3,0.3,0.3,0.3,0.3,0.3,0.3,0.3,0.3,0.3,0.25,0.25],"mouth":{"at":[66,227],"into":"the
        bay, through an inlet in the north dune"},"head_of_tide":{"at":[-96,249.3]},"source":"pond.nmc_north_creek_pond","tidal_reach_m":165,"fresh_reach_m":24,"banks":{"mud":3,"upper":5.5,"note":"mud
