          0.95
        ],
        "sill_z": 0.92,
        "head_z": 2.84
      },
      "slats": 12,
      "slat_m": 0.16,
      "travel_m": 1.92,
      "track": "vertical 1.88 m up the rear plane (y -3.03), then forward under the roof — the stack lies flat at z 2.88, above the door head and below the ceiling",
      "rule": "the door NEVER leaves the body: the painted bbox at N is identical closed and open, and the harness asserts it. Zero keep-clear behind the truck.",
      "stack_over": {
        "y": [
          -2.97,
          -1.05
        ],
        "z": [
          2.88,
          2.93
        ]
      }
    },
    "gate": {
      "param": "gate",
      "range": [
        0,
        1
      ],
      "phases": {
        "swing": [
          0,
          0.45,
          "the folded platform swings from the stow under the tail to dock height, level with the floor"
        ],
        "unfold": [
          0.45,
          0.7,
          "the flip half rotates 180deg aft — full 1.20 m platform at dock height"
        ],
        "lower": [
          0.7,
          1,
          "the arms lower the level platform to the ground"
        ]
      },
      "platform_m": {
        "width": 1.9,
        "main": 0.62,
        "flip": 0.58,
        "total_depth": 1.2,
        "thickness": 0.05
      },
      "dock_z": 0.92,
      "ground_z": 0.03,
      "arm_pivot": [
        0.72,
        -2.62,
        0.56
      ],
      "stowed": "folded double under the tail, forward edge y -2.56 z 0.66, tilted 26deg — inside the LOA, above the 0.20 m hard clearance",
      "deployed_over": {
        "y": [
          -3.1,
          -4.3
        ],
        "x": [
          -0.95,
          0.95
        ]
      },
      "part": "liftgate:true|false — false removes the mechanism entirely (plain-tail build with the same bumperettes and ICC bar)"
    },
    "tilt": {
      "param": "tilt",
      "range": [
        0,
        1
      ],
      "deg": [
        0,
        38
      ],
      "hinge": "x-axis at y 3.20 z 0.50 — the front bumper stays; cab, doors, mirrors, steps and interior all ride it",
      "bares": "engine block, valve cover, radiator wall and air cleaner on the chassis; this class has NO hood",
      "extreme": "at full tilt the roof leading edge reaches y 4.26 at z 1.96 — still inside the cell in all 8 facings"
    },
    "roll": {
      "param": "roll",
      "units": "revolutions",
      "per_wheel": [
        "wFL",
        "wFR",
        "wRL",
        "wRR"
      ],
      "distance_per_rev_m": 2.099,
      "cyclic": "one revolution returns hub lugs and hand-holes exactly and the tread to a 0.7 mm phase (21.007 stripes of 0.0999 m): the seam is 0 px of 20154 painted (0.00%). Seamless in motion; the index notch keeps it honest."
    },
    "suspension": {
      "params": [
        "susF",
        "susR"
      ],
      "range": [
        -1,
        1
      ],
      "travel_m": {
        "front": 0.09,
        "rear": 0.12
      },
      "formula": "dz(y) = -(susF*0.09)*t - (susR*0.12)*(1-t),  t = (y - (-1.50)) / 4.12",
      "note": "the BODY moves (cab, box, door, liftgate); the wheels stay on the ground"
    },
    "steer": {
      "param": "steer",
      "range": [
        -1,
        1
      ],
      "sense": "+1 is full LEFT lock (the nose swings toward -x)",
      "deg": {
        "inner": 33,
        "outer": 27.53
      },
      "geometry": "Ackermann: the inside wheel takes the larger angle. outer = atan(1/(1/tan(inner) + track/wheelbase)), front track 1.56, wheelbase 4.12.",
      "axis": "vertical, through each front wheel centre. No kingpin offset, no caster, no scrub radius.",
      "swept_extreme_x_m": 1.062,
      "note": "cabovers steer tight — the wheels sit at the corner. At full lock a tire corner reaches |x| 1.062 m, inside the 1.07 m black arch flares; the flares, not the 0.98 m cab side, are the envelope. That is why this class carries 33deg to the van's 24."
    },
    "yaw": {
      "param": "yaw",
      "units": "degrees",
      "range": [
        -45,
        45
      ],
      "what": "heading off the 45deg facing grid. Rotates the model about z before projection under the fixed key — the shading is REBAKED, not rotated.",
      "pivot": "unaffected — the origin still projects to the published pivot at any yaw"
    },
    "parts": {
      "mirrors": true,
      "mudflaps": true,
      "liftgate": true
    },
    "night": {
      "param": "night",
      "effect": "glass ramp swaps, headlamps become glow, lit spill on neighbouring pixels"
    },
    "weather": {
      "param": "weather",
      "range": [
        0,
        1
