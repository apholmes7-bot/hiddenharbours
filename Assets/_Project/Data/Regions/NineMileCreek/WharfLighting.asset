MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4080770848284654832da6e1e1aff82a, type: 3}
  m_Name: WharfLighting
  m_EditorClassIdentifier: HiddenHarbours.World::HiddenHarbours.World.WharfLightingDef
  Id: lighting.nmc_wharf
  DisplayName: Nine Mile Creek wharf
  LanternSites:
  - {x: 84.6, y: 87}
  - {x: 97.2, y: 87}
  - {x: 115.5, y: 87}
  - {x: 132, y: 87}
  - {x: 147.7, y: 87}
  - {x: 163.5, y: 87}
  - {x: 176, y: 87}
  - {x: 58, y: 77}
  - {x: 74.8, y: 77}
  LanternsCastShadows: 1
  LanternIntensityScale: 2.5
  LanternReachMetres: 7.5
  LitPoleIds:
  - prop.nmc_light_court
  - prop.nmc_light_lot
  - prop.nmc_light_quay_w
  - prop.nmc_light_quay_e
  - prop.nmc_light_ramp
  - prop.nmc_light_lot_e
  PolesCastShadows: 1
  PoleIntensityScale: 1.6
  PoleReachMetres: 9
  MarkerBloomMetres: 1
  MarkerIntensity: 1.6
  MarkerEdgeSoftness: 0.6
  WestGreen: {r: 0.3, g: 1, b: 0.5, a: 1}
  EastRed: {r: 1, g: 0.22, b: 0.15, a: 1}
  Why: 'The wharf stood dark at night: no lamp on it carried a light. Seven lantern
    posts along the fleet and east walls and two on the west apron, each a metre back
    from the lip beside a ladder or a working berth and clear of the cleats, rings,
    brows and the tide staff, light it the way St Peters'' wharf is lit; the six lamp
    poles on the land side carry the fuel stop''s floodlight. St Peters'' strength
    left this wall near black at night; night must stay readable, so the lanterns
    burn 2.5 times the shared lantern preset with a 7.5 m pool and the poles 1.6 times
    the floodlight with a 9 m pool, enough to make out a person and a boat at the
    wall. The harbour lights were
    a 6 m saturated disc on the tower''s foot; they are now a small marker glow on
    the lens.'
