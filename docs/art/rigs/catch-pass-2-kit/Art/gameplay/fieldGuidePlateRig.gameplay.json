    "FishIso2",
    "Crustacean2",
    "Shellfish2",
    "NotebookKit"
  ],
  "grid": {
    "world": "32 px = 1 m, strict, in the world: the plate does not change it",
    "page": "P page units to the metre, a multiple of 20 (every bar whole units), one per species and page size (cols × lines), the same at both of a page size’s tiers",
    "rigPixel": "one catch-rig pixel per page unit (m = 1): each species is its own rig’s plate drawing, renderPlate(species, P / 32), in its rig’s plate cell (pass E), and nothing is resampled",
    "screen": "the notebook kit’s integer scale s takes a page unit to s × s px"
  },
  "bar": {
    "ladder_m": [
      1,
      0.5,
      0.25,
      0.2,
      0.1,
      0.05
    ],
    "minUnits": 6,
    "rule": "the longest on the ladder no longer than the drawing; set in the kit’s caption row a cell after its label, straight, in pencil; the label is the caption"
  },
  "plate": {
    "rect": "NotebookKit layout().plate, the kit’s room for a plate that is not part of a section, on the squared leaf",
    "pad": "3 units clear of the frame",
    "frame": "the kit’s plate(): frame, corner ticks, caption",
    "fill": "the species, centred, then the bar",
    "turn": "when the words run onto the squared leaf the plate turns the page: the next spread carries the name and the plate"
  },
  "words": {
    "source": "the def only: DisplayName; Flavor up to its first team note (“<WORD> NOTE:”); MinWeightKg-MaxWeightKg kg; Seasons, AllowedGear and DepthBands where the def carries them, by Gear.cs’s enum names (C# [Flags] ToString, split at capitals)",
    "layout": "blocks(): the name and the body as one kit section, then one section a line for each fact, no labels"
  },
