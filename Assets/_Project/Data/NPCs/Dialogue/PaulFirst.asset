  m_Script: {fileID: 11500000, guid: 88201f4f4f3247558c87e55aa4fb8ac4, type: 3}
  m_Name: PaulFirst
  m_EditorClassIdentifier: HiddenHarbours.World::HiddenHarbours.World.DialogueDef
  Id: dialogue.paul_first
  FirstLines:
  - 'Paul Landry. We took the white gable, the four of us, and the roof only leaks where we don''t sleep.'
  - 'Two of ours at Eileen''s school now, Lucie and Sam. She counted them twice to be sure.'
  - 'I mend what the wind takes off this place. On an island that''s steady work.'
  RepeatLines:
  - 'Roof''s holding. So are we.'
