    - Key: nmc.plan.bridges
      Value: '[{"id":"bridge.nmc_route91_river","name":"the Route 91 bridge","on":"road.nmc_route_91","over":"stream.nmc_town_river","centre":[-176.8,205],"span":36,"deck":6,"width":9.5,"spans":3,"piers":2,"clearance_at_spring_high":3.1,"boardwalks_under":2,"headroom_over_boardwalk":2.3,"abutments":{"south":[-176.9,187],"north":[-176.7,223]},"embankment":{"south":[[-177,160],[-176.9,187]],"north":[[-176.7,223],[-177.5,232]],"top":6,"side_slope":1.5},"ruled":"08-20:
        the bridge gets its own artwork","why":"Bench to bench over the tidal river:
        the two boardwalks pass under its end spans, small boats under its middle
