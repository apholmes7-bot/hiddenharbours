        (09-26)","pts":[[-83.5,9.5],[-76,-6],[-80,-22],[-72,-38],[-70,-52],[-66,-62],[-58,-78],[-63,-92],[-54,-110],[-50,-128],[-45,-149],[-42,-165],[-40,-178],[-38.5,-190],[-37,-202]],"z":[4.55,4.42,4.25,4,3.75,3.5,3.3,3.1,2.85,2.6,2.28,1.5,0.55,-0.35,-1.1],"w":[2.4,2.4,2.5,2.6,2.8,3.4,2.8,2.8,2.8,3,2.8,3.2,3.6,4.2,4.6],"depth":[0.25,0.25,0.25,0.25,0.3,0.5,0.25,0.25,0.25,0.3,0.3,0.25,0.2,0.2,0.2],"source":"pond.nmc_camp_pond","mouth":{"at":[-37,-202],"into":"the
