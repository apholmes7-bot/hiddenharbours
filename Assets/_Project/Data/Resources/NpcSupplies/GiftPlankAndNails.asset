  m_Script: {fileID: 11500000, guid: 6c3c8bd3b02941d99e180e39cca49d30, type: 3}
  m_Name: GiftPlankAndNails
  m_EditorClassIdentifier: HiddenHarbours.World::HiddenHarbours.World.SupplyGiftDef
  Id: supplygift.st_peters_plank_and_nails
  GiverNpcId: npc.odile_marchand
  OptionId: option.ask_for_plank_and_nails
  RowLabel: 'Would you have a plank and some copper nails for a dory?'
  ReplyLines:
  - 'I keep a boat out here I never row any more. Watching suits me better.'
  - 'Here''s a plank cut for a patch, and a packet of copper nails. Fasten her right.'
  ItemIds:
  - supply.patch_plank
  - supply.copper_nails
  ReceivedFlags:
  - st_peters.dory_mend.patch_plank
  BagId: shoppingbag.paper
  HandsFullLines:
  - 'Your hands are full. Come back with one free and it''s yours.'
  BagFullLines:
  - 'That bag won''t take another thing. Empty it and come back.'
  BagElsewhereLines:
  - 'Where''s your bag got to? Fetch it and I''ll fill it.'
