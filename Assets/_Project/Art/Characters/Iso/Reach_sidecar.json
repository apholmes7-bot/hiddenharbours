      "Art/characterIsoRig6.hands.js"
    ],
    "canonical": true,
    "frozen_clips_rebake_byte_identical": true,
    "note": "full current source, not a bundled copy. Every clip that existed at 6.5 re-bakes byte-identical (verified cell-by-cell against the 6.5 kit copy across all 29 clips x 8 facings)."
  },
  "cell": {
    "w": 64,
    "h": 92,
    "pivot": {
      "x": 32,
      "y": 82
    },
    "ground_inset": 10,
    "px_per_m": 32,
    "elev_deg": 40,
    "facing_order": [
      "N",
      "NE",
      "E",
      "SE",
      "S",
      "SW",
      "W",
      "NW"
    ],
    "note": "the reach family fits the STANDARD cell - measured bbox over 10 presets x 3 rests x 8 facings x 6 frames is x -20..+19, y -41..+5 from the pivot. No new cell, no new inset."
  },
  "clips": {
    "reach": {
      "frames": 6,
      "ms_per_frame": 100,
      "one_shot": true,
      "mount": "rest",
      "contract": "reachMount(dir, opts)",
      "frame_to_u": "u = f/(frames-1) - the last frame is the settled rest at u=1 (ANIMS.reach.settle)",
      "release_at": 0.72,
      "arrive_at": 0.62,
      "gripped_frames": [
        0,
        1,
        2,
        3
      ],
      "empty_frames": [
        4,
        5
      ],
      "opts": {
        "lift": "world metres, the rest surface height (not scaled by build)",
        "rest": "'ground' | 'stowV' | 'stowH' - sugar for REACH_LIFT",
        "gripRise": "metres, the grip centre above the rest surface (default 0.095)",
        "gripPath": "[REST_FRAMES] points in body-local metres - the tool rig's own grip path; the hand tracks it exactly until the release",
        "gripOf": "function(u) -> [x,y,z], same contract as gripPath",
        "hand": "'R' (default) | 'L'"
      },
      "pickup": "play the frames in reverse: a 0.72 release mirrors to a 0.28 grip-close, so the hand arrives empty, closes, then lifts"
    },
    "run": {
      "frames": 6,
      "ms_per_frame": 80,
      "stride_m": 0.24,
      "lean_deg": 11,
      "mount": "free"
    }
  },
  "reach_lift_m": {
    "ground": 0,
    "stowV": 0.95,
    "stowH": 1.05
  },
  "reach_lift_source": "PLACEHOLDER VALUES. The tool rig's restLift() is the oracle - ground is 0.00 and correct; stowV 0.95 / stowH 1.05 are our reading of 'rack height, roughly standing reach' and were used for the shipped sheets. Pass restLift() in as opts.lift and the clip re-solves; re-bake only if it differs by more than about 0.06 m (2 px at 32 px/m).",
  "grip_rise_m": 0.095,
  "sync_verification": {
    "hand_on_grip_px": 0,
    "method": "reachMount().slip - the distance between the point the clip was asked to put the hand on and where pose() actually put it, measured over 10 presets x 3 rests x 8 facings x 6 frames",
    "max_arm_stretch_px": 2.89,
    "max_arm_stretch_case": "girl/stowV/d0/f3 - a child at a rack above her reach, reported as clamped:true",
    "adult_max_arm_stretch_px": 1.16,
    "frozen_hold_clip_arm_stretch_px": 1.5,
    "seams": {
      "hold last frame -> reach frame 0": "0.008 m (0.2 px)",
      "reach last frame -> idle frame 0": "0.003 m (0.07 px)"
    }
  },
