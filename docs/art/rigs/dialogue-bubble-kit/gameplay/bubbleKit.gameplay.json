{
  "kit": "dialogue-bubble-kit",
  "version": 2,
  "generated": "read out of Art/dialogueBubbleRig.js + Art/talkCueRig.js at their defaults — regenerate, never hand-edit",
  "purpose": "the gameplay-facing half of the contract: the numbers a presenter needs to wrap text, drive a per-character fill, anchor a bubble on a speaker, grow an option list and hit-test a row",
  "loadOrder": [
    "Art/dialogueBubbleRig.js",
    "Art/talkCueRig.js"
  ],
  "globals": {
    "dialogueBubbleRig": "BubbleKit",
    "talkCueRig": "TalkCue"
  },
  "dependencies": {
    "required": "none — both rigs are standalone and draw into any 2D context",
    "harnessOnly": [
      "Art/characterIsoRig6.js",
      "Art/headIsoRig3.js",
      "Art/eyeIsoRig.js"
    ],
    "speakerSide": "the talk cues apply to characterIsoRig6 (pass 6.3) or any pass that keeps its anchors() contract"
  },
  "grid": {
    "ppu": 32,
    "unit": "32 px = 1 m",
    "why": "The bubble is an object IN the scene (diegetic doctrine), so it is authored on the same grid as the props it stands among — 32 px/m, the assets grid every shipped rig in this repo bakes at. The 24 px/m grid is the camera-side number (memory two-pixel-grids-ppu-vs-assetsppu); authoring there would put UI pixels on a different pitch from world pixels and the bubble would read as an overlay."
  },
  "baked": {
    "anything": false,
    "note": "nothing here bakes. Every piece is live-drawn from the rig at native resolution, like the wall calendar face — feed it state. If the import wants slices, panel(ctx,x,y,18,18) IS the nine-slice tile."
  },
  "calls": {
    "speech": "BubbleKit.say(ctx, x, y, { text, cols, name, tail, fill, frame, stock, marker, caret }) -> layout",
    "place": "BubbleKit.mount(speakerAnchor, { tail, clear, gap }) -> { x, y } — the tail tip lands clear of the sprite",
    "measureOnly": "BubbleKit.layoutSay(x, y, o) — same maths, nothing drawn",
    "options": "BubbleKit.options(ctx, x, y, { rows, sel, cols, highlight, cursor, stock }) -> layout",
    "placeOptions": "BubbleKit.optionsMount(sayLayout, { rows, cols, bounds }) -> { x, y, w, h, side, away, vSide, clearFromTail, clamped }",
    "talk": "CharacterIso6.render(dir, { t, talk: fill < chars, expr }) — the mouth cadence already ships",
    "cue": "TalkCue.body({ t, talking, startedAt, stoppedAt, emote, emoteAt }) -> { dy } — whole-px screen offset for the speaker blit",
    "emote": "TalkCue.markerAt(headAnchor, { emote, side, place }) then TalkCue.marker(ctx, x, y, kind, { t, stock })",
    "probe": "TalkCue.probeMouth(CharacterIso6) -> { pass, px, t, bbox } — run it in CI and fail on it"
  },
  "type": {
    "cell": {
      "w": 5,
      "h": 10,
      "glyph": [
        4,
        8
      ],
      "advance": 5,
      "capHeight": 6,
      "xHeight": 4,
      "ascender": 6,
      "descender": 2,
      "baselineRow": 5,
      "leading": 2,
      "lineHeight": 10
    },
    "wrap": "charsPerLine = cols = floor((textBoxWidth + 1) / 5)  ·  BubbleKit.colsFor(px)",
    "fill": "one cell per character, left to right, line by line; layout.rows[] gives each line its cell origin, and layout.chars the total the cadence divides",
    "case": {
      "body": "sentence case (owner ruling, 2026-08-17)",
      "labels": "name chip and option rows in CAPS"
    },
    "charsPerLine": "cols; BubbleKit.colsFor(px) converts a pixel width",
    "panelFormula": {
      "w": "insetL + (cols × 5 − 1) + insetR",
      "h": "insetT + (lines − 1) × 10 + 8 + insetB"
    },
