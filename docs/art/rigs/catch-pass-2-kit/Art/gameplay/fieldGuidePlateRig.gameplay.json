  "api": {
    "render": "render({id, words, cols, lines, scale, plate}) → { pages: [{canvas, U, plate}], turned, size } · plate:false draws the kit alone (its empty room, its own caption)",
    "draw": "draw(ctx, X, Y, W, H, o) → spread o.spread (0, or 1 when it turned) into a rect, as NotebookKit.drawUnit does, page “knowledge”",
    "plan": "plan(X, Y, W, H, o) → { blocks, flow, turned, pages }, nothing drawn",
    "fit": "fit(defId, plateRect, s) → { P, m, scale, units, bar, drawing, at }",
    "fillFor": "fillFor(fit) → the fill for NotebookKit.plate(ctx, layout, {fill})",
    "blocks": "blocks({name, body, facts}) → the kit’s sections",
    "drawing": "drawing(defId, P) → the species’ own rig’s plate drawing, renderPlate(species, P / 32), cropped, as runs"
  },
  "probesToRun": [
    "FieldGuidePlate.probeFit()",
    "FieldGuidePlate.probeWords(words)",
    "FieldGuidePlate.probeScale()",
    "FieldGuidePlate.probeInk()"
  ],
