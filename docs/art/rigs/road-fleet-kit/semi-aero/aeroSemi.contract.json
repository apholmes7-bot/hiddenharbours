      ],
      "hinge": "x-axis at y 4.02 z 0.55 — the bumper stays; hood, fenders, arches, grille and headlamps all ride it. The CAB does not move.",
      "bares": "engine block, valve cover, radiator wall and air cleaner; twin latches at the cowl corners",
      "extreme": "at full tilt the hood nose reaches y 4.72 and the cowl edge z 2.76 — still inside the cell in all 8 facings."
    },
    "skirts": {
      "part": "skirts:true|false",
      "default": true,
      "what": "aero chassis fairings between the axles; false bares frame, tanks and battery box",
      "rule": "no z changes and an IDENTICAL painted bbox either way (asserted) — pack once, toggle freely"
    },
    "roll": {
      "param": "roll",
      "units": "revolutions",
      "per_wheel": [
        "wFL",
        "wFR",
        "wRL",
        "wRR"
      ],
      "distance_per_rev_m": 3.142,
      "cyclic": "one revolution returns the 10-fold lugs exactly and the tread to a sub-pixel phase (29.008 stripes of 0.1083 m): the seam is 32 px of 21205 painted (0.15%). Each tandem side shares its corner roll."
    },
    "suspension": {
      "params": [
        "susF",
        "susR"
      ],
      "range": [
        -1,
        1
      ],
      "travel_m": {
        "front": 0.09,
        "rear": 0.11
      },
      "formula": "dz(y) = -(susF*0.09)*t - (susR*0.11)*(1-t),  t = (y - (-2.30)) / 5.25",
      "note": "the BODY moves — including the fifth wheel and its coupling point; the wheels stay on the ground"
    },
    "steer": {
      "param": "steer",
      "range": [
        -1,
        1
      ],
      "sense": "+1 is full LEFT lock (the nose swings toward -x)",
      "deg": {
        "inner": 32,
        "outer": 27.51
      },
      "geometry": "Ackermann: the inside wheel takes the larger angle. outer = atan(1/(1/tan(inner) + track/wheelbase)), front track 1.68, wheelbase 5.25 (to the tandem centre).",
      "axis": "vertical, through each front wheel centre. No kingpin offset, no caster, no scrub radius.",
      "swept_extreme_x_m": 1.232,
      "note": "bobtail geometry — a coupled trailer tracks inside the arc and its off-tracking is the game’s arithmetic. The painted fenders (half-width 1.27 m) are the envelope."
    },
    "yaw": {
      "param": "yaw",
      "units": "degrees",
      "range": [
        -45,
        45
      ],
      "what": "heading off the 45deg facing grid. Rotates the model about z before projection under the fixed key — the shading is REBAKED, not rotated.",
      "pivot": "unaffected — the origin still projects to the published pivot at any yaw",
      "painted_bbox_over_sweep": [
        55,
        94,
        328,
        294
      ],
      "coupled": "a tractor+trailer pair is two yaws hinged at the coupling point; the articulation angle is their difference"
    },
